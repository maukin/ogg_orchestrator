from __future__ import annotations

import json
import os
import shlex
import subprocess
from abc import ABC, abstractmethod
from datetime import datetime, timezone
from pathlib import Path

from app.models.attach_replicat import AttachReplicatCommand
from app.models.attach_replicat_result import AttachReplicatExecutionResult


def _utc_now() -> str:
    return datetime.now(timezone.utc).isoformat()


class AttachReplicatExecutor(ABC):
    @abstractmethod
    def execute(
        self,
        commands: list[AttachReplicatCommand],
        artifacts_dir: str | Path,
    ) -> AttachReplicatExecutionResult:
        raise NotImplementedError


class FileOnlyAttachReplicatExecutor(AttachReplicatExecutor):
    def execute(
        self,
        commands: list[AttachReplicatCommand],
        artifacts_dir: str | Path,
    ) -> AttachReplicatExecutionResult:
        out_dir = Path(artifacts_dir)
        out_dir.mkdir(parents=True, exist_ok=True)

        request_path = out_dir / "attach_replicat_request.json"
        response_path = out_dir / "attach_replicat_response.json"

        payload = {
            "commands": [
                {
                    "table_id": c.table_id,
                    "source_schema": c.source_schema,
                    "source_table": c.source_table,
                    "target_schema": c.target_schema,
                    "target_table": c.target_table,
                    "replicat_group": c.replicat_group,
                    "fragment_path": c.fragment_path,
                    "command_type": c.command_type,
                    "command_text": c.command_text,
                    "mode": c.mode,
                    "reason": c.reason,
                }
                for c in commands
            ]
        }

        request_path.write_text(
            json.dumps(payload, ensure_ascii=False, indent=2),
            encoding="utf-8",
        )

        now = _utc_now()
        group_name = commands[0].replicat_group if commands else None

        result_payload = {
            "success": True,
            "executed_count": len(commands),
            "skipped_count": 0,
            "group_name": group_name,
            "applied_tables_count": len(commands),
            "started_at": now,
            "finished_at": now,
            "raw_output": "File-only attach replicat contract artifact created.",
            "error_code": None,
            "error_message": None,
        }
        response_path.write_text(
            json.dumps(result_payload, ensure_ascii=False, indent=2),
            encoding="utf-8",
        )

        return AttachReplicatExecutionResult(
            success=True,
            executed_count=len(commands),
            skipped_count=0,
            group_name=group_name,
            applied_tables_count=len(commands),
            started_at=now,
            finished_at=now,
            raw_output=result_payload["raw_output"],
            error_code=None,
            error_message=None,
            request_artifact=str(request_path),
            response_artifact=str(response_path),
        )


class ScriptAttachReplicatExecutor(AttachReplicatExecutor):
    def __init__(self, script_command: str, timeout_sec: int = 1800):
        self.script_command = script_command
        self.timeout_sec = timeout_sec

    def execute(
        self,
        commands: list[AttachReplicatCommand],
        artifacts_dir: str | Path,
    ) -> AttachReplicatExecutionResult:
        out_dir = Path(artifacts_dir)
        out_dir.mkdir(parents=True, exist_ok=True)

        request_path = out_dir / "attach_replicat_request.json"
        response_path = out_dir / "attach_replicat_response.json"
        stdout_path = out_dir / "attach_replicat_stdout.log"
        stderr_path = out_dir / "attach_replicat_stderr.log"

        payload = {
            "commands": [
                {
                    "table_id": c.table_id,
                    "source_schema": c.source_schema,
                    "source_table": c.source_table,
                    "target_schema": c.target_schema,
                    "target_table": c.target_table,
                    "replicat_group": c.replicat_group,
                    "fragment_path": c.fragment_path,
                    "command_type": c.command_type,
                    "command_text": c.command_text,
                    "mode": c.mode,
                    "reason": c.reason,
                }
                for c in commands
            ]
        }
        request_path.write_text(
            json.dumps(payload, ensure_ascii=False, indent=2),
            encoding="utf-8",
        )

        rendered = self.script_command.format(
            request=str(request_path),
            response=str(response_path),
        )

        try:
            if os.name == "nt":
                process = subprocess.run(
                    rendered,
                    capture_output=True,
                    text=True,
                    timeout=self.timeout_sec,
                    check=False,
                    shell=True,
                )
            else:
                argv = shlex.split(rendered, posix=True)
                process = subprocess.run(
                    argv,
                    capture_output=True,
                    text=True,
                    timeout=self.timeout_sec,
                    check=False,
                )
        except subprocess.TimeoutExpired as exc:
            stdout_path.write_text(exc.stdout or "", encoding="utf-8")
            stderr_path.write_text(exc.stderr or "", encoding="utf-8")
            return AttachReplicatExecutionResult(
                success=False,
                executed_count=0,
                skipped_count=0,
                group_name=commands[0].replicat_group if commands else None,
                applied_tables_count=None,
                started_at=None,
                finished_at=None,
                raw_output=exc.stdout,
                error_code="TIMEOUT",
                error_message=f"Attach replicat script timed out after {self.timeout_sec} seconds.",
                request_artifact=str(request_path),
                response_artifact=str(response_path) if response_path.exists() else None,
            )
        except FileNotFoundError as exc:
            stdout_path.write_text("", encoding="utf-8")
            stderr_path.write_text(str(exc), encoding="utf-8")
            return AttachReplicatExecutionResult(
                success=False,
                executed_count=0,
                skipped_count=0,
                group_name=commands[0].replicat_group if commands else None,
                applied_tables_count=None,
                started_at=None,
                finished_at=None,
                raw_output=None,
                error_code="FILE_NOT_FOUND",
                error_message=str(exc),
                request_artifact=str(request_path),
                response_artifact=str(response_path) if response_path.exists() else None,
            )

        stdout_path.write_text(process.stdout or "", encoding="utf-8")
        stderr_path.write_text(process.stderr or "", encoding="utf-8")

        if process.returncode != 0:
            return AttachReplicatExecutionResult(
                success=False,
                executed_count=0,
                skipped_count=0,
                group_name=commands[0].replicat_group if commands else None,
                applied_tables_count=None,
                started_at=None,
                finished_at=None,
                raw_output=process.stdout,
                error_code=f"EXIT_{process.returncode}",
                error_message=process.stderr or "Attach replicat script failed.",
                request_artifact=str(request_path),
                response_artifact=str(response_path) if response_path.exists() else None,
            )

        if not response_path.exists():
            return AttachReplicatExecutionResult(
                success=False,
                executed_count=0,
                skipped_count=0,
                group_name=commands[0].replicat_group if commands else None,
                applied_tables_count=None,
                started_at=None,
                finished_at=None,
                raw_output=process.stdout,
                error_code="MISSING_RESPONSE",
                error_message="Attach replicat script completed but did not create response file.",
                request_artifact=str(request_path),
                response_artifact=None,
            )

        response_payload = json.loads(response_path.read_text(encoding="utf-8"))
        return AttachReplicatExecutionResult(
            success=bool(response_payload.get("success")),
            executed_count=int(response_payload.get("executed_count", 0)),
            skipped_count=int(response_payload.get("skipped_count", 0)),
            group_name=response_payload.get("group_name"),
            applied_tables_count=response_payload.get("applied_tables_count"),
            started_at=response_payload.get("started_at"),
            finished_at=response_payload.get("finished_at"),
            raw_output=response_payload.get("raw_output"),
            error_code=response_payload.get("error_code"),
            error_message=response_payload.get("error_message"),
            request_artifact=str(request_path),
            response_artifact=str(response_path),
        )